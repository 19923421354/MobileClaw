<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for AI API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Foreground service for persistent claw agent -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Storage permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Overlay / floating window -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Battery stats (via Shizuku) -->
    <uses-permission android:name="android.permission.BATTERY_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Keep device awake during operations -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package query -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Kill background processes (for closeApp fallback) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Usage stats (for app usage info) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Phone state (for device info) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Vibrate for feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Boot complete (auto-start service) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Exact alarm for scheduled tasks -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Camera (for QR code scanning etc.) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Optional: audio recording (for voice input) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Optional: contacts (for finding recipients when sending messages) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Optional: SMS (for sending text messages) -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Optional: phone calls -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Shizuku permission -->
    <permission
        android:name="com.mobileclaw.app.permission.SHIZUKU"
        android:protectionLevel="normal" />

    <!-- Location (for location-based tasks) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Calendar (for calendar operations) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Bluetooth (for Bluetooth operations) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- System settings (for modifying system settings) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION"
        tools:ignore="ProtectedPermissions" />

    <!-- Status bar (for expanding/collapsing status bar) -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- SMS reading (for reading SMS messages) -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Call log (for call log operations) -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />

    <!-- Audio settings (for modifying audio settings) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Network state change (for network operations) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Flashlight (for camera flash) -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />

    <!-- NFC (for NFC operations) -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- 包可见性声明：确保能发现 Shizuku / STELLAR 的服务 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="roro.stellar.manager" />
        <package android:name="com.rosan.dhizuku" />
        <intent>
            <action android:name="rikka.shizuku.intent.action.BIND_SHIZUKU_SERVICE" />
        </intent>
    </queries>

    <!-- Body sensors (for health/fitness tasks) -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Get accounts (for account info) -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <!-- Modify phone state (for advanced phone operations, needs privileged) -->
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />

    <!-- Install shortcuts (for creating app shortcuts) -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- Read app badges / notifications (for notification access) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:name=".MobileClawApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileClaw"
        tools:targetApi="34">

        <!-- Shizuku Provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.MobileClaw">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider for APK installation (fallback when Shizuku is not available) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Accessibility Service for screen control -->
        <service
            android:name=".accessibility.ScreenAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Foreground service for the claw agent -->
        <service
            android:name=".service.ClawAgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Floating quick panel service -->
        <service
            android:name=".service.FloatingPanelService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Model Management Activity -->
        <activity
            android:name=".ModelManagementActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.MobileClaw" />

    </application>

</manifest>
