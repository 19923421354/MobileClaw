<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ================================================================ -->
    <!-- 主主题：Material Design 3 (Material You) + 蓝紫渐变品牌色         -->
    <!-- ================================================================ -->
    <style name="Theme.MobileClaw" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 品牌色 - 蓝紫渐变主色 -->
        <item name="colorPrimary">#FF667EEA</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">#FFDDE3FF</item>
        <item name="colorOnPrimaryContainer">#FF001B3E</item>

        <!-- 品牌色 - 辅助色（紫色） -->
        <item name="colorSecondary">#FF7B4DFF</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="colorSecondaryContainer">#FFEADEFF</item>
        <item name="colorOnSecondaryContainer">#FF20005E</item>

        <!-- 品牌色 - 第三色（青色点缀） -->
        <item name="colorTertiary">#FF00BFA5</item>
        <item name="colorOnTertiary">#FFFFFFFF</item>
        <item name="colorTertiaryContainer">#FFA0F2E1</item>
        <item name="colorOnTertiaryContainer">#FF002019</item>

        <!-- 错误色 -->
        <item name="colorError">#FFEF4444</item>
        <item name="colorOnError">#FFFFFFFF</item>
        <item name="colorErrorContainer">#FFFFDAD6</item>
        <item name="colorOnErrorContainer">#FF410002</item>

        <!-- 背景与表面 -->
        <item name="android:colorBackground">#FFF8F9FE</item>
        <item name="colorOnBackground">#FF1A1C2E</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="colorOnSurface">#FF1A1C2E</item>
        <item name="colorSurfaceVariant">#FFE7E0EC</item>
        <item name="colorOnSurfaceVariant">#FF49454F</item>

        <!-- 轮廓色 -->
        <item name="colorOutline">#FF79747E</item>
        <item name="colorOutlineVariant">#FFCAC4D0</item>

        <!-- 窗口背景 -->
        <item name="android:windowBackground">#FFF8F9FE</item>

        <!-- 状态栏 - 浅色 -->
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="m">true</item>

        <!-- Material Design 3 Dynamic Color 支持（Android 12+） -->
    </style>

    <!-- ================================================================ -->
    <!-- 品牌色 - 主色系（蓝紫渐变）                                      -->
    <!-- ================================================================ -->
    <color name="brand_primary">#FF667EEA</color>
    <color name="brand_primary_dark">#FF4A5FD4</color>
    <color name="brand_primary_light">#FFDDE3FF</color>
    <color name="brand_primary_gradient_start">#FF667EEA</color>
    <color name="brand_primary_gradient_end">#FF7B4DFF</color>

    <!-- 品牌色 - 辅色系（紫色） -->
    <color name="brand_secondary">#FF7B4DFF</color>
    <color name="brand_secondary_dark">#FF5C2FD6</color>
    <color name="brand_secondary_light">#FFEADEFF</color>

    <!-- 品牌色 - 强调色（青色） -->
    <color name="brand_accent">#FF00BFA5</color>
    <color name="brand_accent_light">#FFA0F2E1</color>

    <!-- 品牌色 - 紫 -->
    <color name="brand_purple">#FF7C4DFF</color>
    <color name="brand_purple_light">#FFF0EBFF</color>

    <!-- 背景渐变 -->
    <color name="bg_gradient_start">#FF667EEA</color>
    <color name="bg_gradient_end">#FF7B4DFF</color>
    <color name="bg_gradient_light_start">#FFF8F6FF</color>
    <color name="bg_gradient_light_end">#FFF0F4FF</color>

    <!-- 背景色系 -->
    <color name="bg_main">#FFF8F9FE</color>
    <color name="bg_card">#FFFFFFFF</color>
    <color name="bg_chat">#FFF8F9FE</color>
    <color name="bg_input">#FFF0F2F8</color>
    <color name="bg_input_focused">#FFE8ECFF</color>

    <!-- 卡片阴影 -->
    <color name="card_shadow_light">#0D000000</color>
    <color name="card_shadow_medium">#1A000000</color>
    <color name="card_shadow_dark">#26000000</color>
    <color name="card_stroke">#FFEDEFF7</color>

    <!-- 表面色 -->
    <color name="surface_white">#FFFFFFFF</color>
    <color name="surface_elevated">#FFFFFFFF</color>

    <!-- 消息气泡 -->
    <color name="user_msg_bg">#FF667EEA</color>
    <color name="user_msg_bg_gradient_start">#FF667EEA</color>
    <color name="user_msg_bg_gradient_end">#FF7B4DFF</color>
    <color name="ai_msg_bg">#FFFFFFFF</color>
    <color name="ai_msg_border">#FFEDEFF7</color>

    <!-- 文字色 -->
    <color name="text_primary">#FF1A1C2E</color>
    <color name="text_secondary">#FF6B7280</color>
    <color name="text_tertiary">#FF9CA3AF</color>
    <color name="text_on_primary">#FFFFFFFF</color>
    <color name="text_on_gradient">#FFFFFFFF</color>
    <color name="text_hint">#FFB0B8C4</color>

    <!-- 分割线 & 边框 -->
    <color name="divider_light">#FFE5E7EB</color>
    <color name="divider_medium">#FFD1D5DB</color>
    <color name="stroke_light">#FFEDEFF7</color>

    <!-- 功能色 -->
    <color name="success_green">#FF10B981</color>
    <color name="success_green_light">#FFECFDF5</color>
    <color name="warning_orange">#FFFF9800</color>
    <color name="warning_orange_light">#FFFFF3E0</color>
    <color name="error_red">#FFEF4444</color>
    <color name="error_red_light">#FFFEF2F2</color>

    <!-- 阴影色 -->
    <color name="shadow_color">#1A000000</color>

    <!-- 图标深蓝色 -->
    <color name="icon_deep_blue">#FF0A1929</color>

    <!-- 空状态建议芯片 -->
    <color name="chip_bg">#FFF0F4FF</color>
    <color name="chip_text_color">#FF667EEA</color>

    <!-- 渐变数组（用于代码中创建 GradientDrawable） -->
    <array name="brand_gradient_colors">
        <item>#FF667EEA</item>
        <item>#FF7B4DFF</item>
    </array>
    <array name="accent_gradient_colors">
        <item>#FF00BFA5</item>
        <item>#FF009688</item>
    </array>
</resources>