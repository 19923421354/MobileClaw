<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Material Design 3 风格，品牌色方案) -->
    <style name="Theme.MobileClaw" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 品牌主色 - 深邃星空蓝 -->
        <item name="colorPrimary">#FF1A73E8</item>
        <item name="colorPrimaryVariant">#FF1557B0</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <!-- 辅助色 - 活力青 -->
        <item name="colorSecondary">#FF00BCD4</item>
        <item name="colorSecondaryVariant">#FF0097A7</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <!-- 背景和表面色 -->
        <item name="android:colorBackground">#FFF5F7FA</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="colorOnSurface">#FF1A1A2E</item>
        <!-- 状态栏 -->
        <item name="android:statusBarColor" tools:targetApi="l">#FF1557B0</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- 窗口背景 -->
        <item name="android:windowBackground">#FFF5F7FA</item>
    </style>

    <!-- 品牌色资源 -->
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>

    <!-- 品牌色 - 主色系 -->
    <color name="brand_primary">#FF1A73E8</color>
    <color name="brand_primary_dark">#FF1557B0</color>
    <color name="brand_primary_light">#FFE8F0FE</color>
    <color name="brand_primary_gradient_start">#FF1A73E8</color>
    <color name="brand_primary_gradient_end">#FF0D47A1</color>

    <!-- 品牌色 - 辅色系 -->
    <color name="brand_secondary">#FF00BCD4</color>
    <color name="brand_secondary_dark">#FF0097A7</color>
    <color name="brand_secondary_light">#FFE0F7FA</color>

    <!-- 品牌色 - 强调色 -->
    <color name="brand_accent">#FFFF9800</color>
    <color name="brand_accent_light">#FFFFF3E0</color>

    <!-- 品牌色 - 紫 -->
    <color name="brand_purple">#FF7C4DFF</color>
    <color name="brand_purple_light">#FFF0EBFF</color>

    <!-- 背景色系 -->
    <color name="bg_main">#FFF5F7FA</color>
    <color name="bg_card">#FFFFFFFF</color>
    <color name="bg_chat">#FFF5F7FA</color>
    <color name="bg_input">#FFF0F2F5</color>

    <!-- 表面色 -->
    <color name="surface_white">#FFFFFFFF</color>
    <color name="surface_elevated">#FFFFFFFF</color>

    <!-- 消息气泡 -->
    <color name="user_msg_bg">#FF1A73E8</color>
    <color name="user_msg_bg_gradient_start">#FF1A73E8</color>
    <color name="user_msg_bg_gradient_end">#FF1557B0</color>
    <color name="ai_msg_bg">#FFFFFFFF</color>
    <color name="ai_msg_border">#FFE8ECF0</color>

    <!-- 文字色 -->
    <color name="text_primary">#FF1A1A2E</color>
    <color name="text_secondary">#FF6B7280</color>
    <color name="text_tertiary">#FF9CA3AF</color>
    <color name="text_on_primary">#FFFFFFFF</color>
    <color name="text_hint">#FFB0B8C4</color>

    <!-- 分割线 & 边框 -->
    <color name="divider_light">#FFE5E7EB</color>
    <color name="divider_medium">#FFD1D5DB</color>
    <color name="stroke_light">#FFE8ECF0</color>

    <!-- 功能色 -->
    <color name="success_green">#FF10B981</color>
    <color name="success_green_light">#FFECFDF5</color>
    <color name="warning_orange">#FFFF9800</color>
    <color name="warning_orange_light">#FFFFF3E0</color>
    <color name="error_red">#FFEF4444</color>
    <color name="error_red_light">#FFFEF2F2</color>

    <!-- 阴影色 -->
    <color name="shadow_color">#1A000000</color>

    <!-- 图标深蓝色 -->
    <color name="icon_deep_blue">#FF0A1929</color>

    <!-- 渐变数组（用于代码中创建 GradientDrawable） -->
    <array name="brand_gradient_colors">
        <item>#FF1A73E8</item>
        <item>#FF1557B0</item>
    </array>
    <array name="accent_gradient_colors">
        <item>#FFFF9800</item>
        <item>#FFF57C00</item>
    </array>
</resources>