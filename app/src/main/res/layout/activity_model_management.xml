<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- ================================================================ -->
    <!-- 顶部标题栏（Material Design 3 风格）                              -->
    <!-- ================================================================ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/surface_white"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <!-- 返回按钮 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/brand_primary_light"
                app:strokeWidth="0dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_action_back"
                    android:tint="@color/brand_primary"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    android:contentDescription="返回" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 标题 -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="本地模型管理"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginHorizontal="8dp" />

            <!-- 刷新按钮 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/brand_primary_light"
                app:strokeWidth="0dp">

                <ImageButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_action_clean"
                    android:tint="@color/brand_primary"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    android:contentDescription="刷新" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ================================================================ -->
    <!-- 搜索栏（Material Design 3 风格 Filled TextField）                 -->
    <!-- ================================================================ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bg_input"
        app:strokeWidth="0dp"
        android:transitionName="searchBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_action_search"
                android:tint="@color/text_tertiary"
                android:contentDescription="搜索" />

            <EditText
                android:id="@+id/editSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:hint="搜索模型名称..."
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:paddingVertical="10dp" />

            <!-- 清除按钮（默认隐藏，代码中控制） -->
            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_action_clean"
                android:tint="@color/text_tertiary"
                android:background="@android:color/transparent"
                android:padding="6dp"
                android:visibility="gone"
                android:contentDescription="清除搜索" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ================================================================ -->
    <!-- 分类标签（Material Design 3 ChipGroup）                          -->
    <!-- ================================================================ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:scrollbars="none"
        android:fadeScrollbars="false">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:singleSelection="true"
            app:selectionRequired="false"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="0dp">

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部"
                style="@style/Widget.Material3.Chip.Filter"
                app:chipBackgroundColor="@color/brand_primary_light"
                app:chipStrokeWidth="0dp"
                app:chipCornerRadius="20dp"
                app:chipIconVisible="false"
                app:checkedIconVisible="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="推荐"
                style="@style/Widget.Material3.Chip.Filter"
                app:chipBackgroundColor="@color/brand_primary_light"
                app:chipStrokeWidth="0dp"
                app:chipCornerRadius="20dp"
                app:chipIconVisible="false"
                app:checkedIconVisible="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="代码"
                style="@style/Widget.Material3.Chip.Filter"
                app:chipBackgroundColor="@color/brand_primary_light"
                app:chipStrokeWidth="0dp"
                app:chipCornerRadius="20dp"
                app:chipIconVisible="false"
                app:checkedIconVisible="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="轻量"
                style="@style/Widget.Material3.Chip.Filter"
                app:chipBackgroundColor="@color/brand_primary_light"
                app:chipStrokeWidth="0dp"
                app:chipCornerRadius="20dp"
                app:chipIconVisible="false"
                app:checkedIconVisible="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- ================================================================ -->
    <!-- 可滚动内容区（支持下拉刷新）                                     -->
    <!-- ================================================================ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ==================================================== -->
                <!-- 状态摘要卡片（渐变背景 + 现代统计卡片设计）           -->
                <!-- ==================================================== -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:background="@drawable/bg_gradient_status_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- 标题行 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_action_chip"
                                android:tint="@color/brand_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="模型状态"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtModelStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="加载中..."
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                        <!-- 统计指标行（三列） -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <!-- 已下载 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/success_green_light"
                                app:strokeWidth="0dp"
                                android:paddingVertical="12dp"
                                android:paddingHorizontal="8dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_action_verified"
                                        android:tint="@color/success_green" />

                                    <TextView
                                        android:id="@+id/txtDownloadCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="0"
                                        android:textSize="24sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/success_green" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="已下载"
                                        android:textSize="11sp"
                                        android:textColor="@color/text_secondary" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- 已加载 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/brand_primary_light"
                                app:strokeWidth="0dp"
                                android:paddingVertical="12dp"
                                android:paddingHorizontal="8dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_action_model"
                                        android:tint="@color/brand_primary" />

                                    <TextView
                                        android:id="@+id/txtLoadedName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="无"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/brand_primary"
                                        android:singleLine="true"
                                        android:ellipsize="end"
                                        android:maxWidth="80dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="已加载"
                                        android:textSize="11sp"
                                        android:textColor="@color/text_secondary" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- 可下载 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/warning_orange_light"
                                app:strokeWidth="0dp"
                                android:paddingVertical="12dp"
                                android:paddingHorizontal="8dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_action_memory"
                                        android:tint="@color/warning_orange" />

                                    <TextView
                                        android:id="@+id/txtAvailableCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="0"
                                        android:textSize="24sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/warning_orange" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="可下载"
                                        android:textSize="11sp"
                                        android:textColor="@color/text_secondary" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ==================================================== -->
                <!-- 导入模型卡片（Material Design 3 风格）               -->
                <!-- ==================================================== -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_stroke"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:id="@+id/layoutImportModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <!-- 导入图标区域 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/brand_primary_light"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_action_model"
                                    android:tint="@color/brand_primary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="导入本地模型文件"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="从 Download 目录导入 .gguf / .onnx / .tflite 文件"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_action_back"
                            android:tint="@color/text_tertiary"
                            android:rotation="180" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                

                <!-- ==================================================== -->
                <!-- 标题：可下载的模型                                     -->
                <!-- ==================================================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_action_chip"
                        android:tint="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="可下载的模型"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- ==================================================== -->
                <!-- 模型列表容器（由代码动态填充）                       -->
                <!-- ==================================================== -->
                <LinearLayout
                    android:id="@+id/layoutModelList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- ==================================================== -->
                <!-- 底部提示卡片（Material Design 3 风格）               -->
                <!-- ==================================================== -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_input"
                    app:strokeWidth="0dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_action_info"
                            android:tint="@color/text_tertiary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="提示：点击模型可直接下载，下载完成后可加载使用。\n本地导入的模型也在此列表中管理。"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>