<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- ============ 顶部头部 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@color/brand_primary"
            android:padding="20dp">

            <ImageView
                android:id="@+id/profileAppIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_action_chip"
                android:tint="@android:color/white"
                android:background="@drawable/ic_action_profile"
                android:backgroundTint="#33FFFFFF"
                android:padding="12dp"
                android:contentDescription="灵爪图标" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="灵爪 MobileClaw"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/profileVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v2.0.5 (build 29)"
                android:textSize="13sp"
                android:textColor="#CCFFFFFF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ============ 功能卡片区域 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 统计卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_white"
                app:strokeWidth="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profileStatsPermissions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/16"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="权限"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:background="@color/divider_light" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profileStatsCommands"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="指令"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:background="@color/divider_light" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profileStatsVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="v2.0.5"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="版本"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 赞助开发 ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSponsor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_white"
                app:strokeWidth="0dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_action_chip"
                            android:tint="#FFFF6B35"
                            android:contentDescription="赞助" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="赞助开发"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FF333333"
                            android:layout_marginStart="8dp" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="请开发者喝杯咖啡 ☕"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="如果灵爪对你有所帮助，欢迎赞助支持！你的支持是持续改进的动力。"
                        android:textSize="13sp"
                        android:textColor="#FF666666"
                        android:layout_marginTop="8dp" />

                    <!-- 二维码区域 - 由代码动态填充 -->
                    <FrameLayout
                        android:id="@+id/profileQrContainer"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/profileQrImage"
                            android:layout_width="180dp"
                            android:layout_height="180dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true" />
                    </FrameLayout>

                    <!-- 支付方式切换 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/profileBtnWechat"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="微信支付"
                            android:textSize="13sp"
                            android:textColor="@android:color/white"
                            android:background="@drawable/ic_action_profile"
                            android:backgroundTint="#FF07C160"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="0dp"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/profileBtnAlipay"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="支付宝"
                            android:textSize="13sp"
                            android:textColor="@android:color/white"
                            android:background="@drawable/ic_action_profile"
                            android:backgroundTint="#FF1677FF"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="0dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="长按或截图保存二维码，打开相应 App 扫码"
                        android:textSize="11sp"
                        android:textColor="#FFAAAAAA"
                        android:gravity="center"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 功能按钮列表 ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_white"
                app:strokeWidth="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- 检查更新 -->
                    <LinearLayout
                        android:id="@+id/profileBtnCheckUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_action_verified"
                            android:tint="@color/brand_accent"
                            android:contentDescription="更新" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="检查更新"
                            android:textSize="15sp"
                            android:textColor="#FF333333"
                            android:layout_marginStart="12dp" />

                        <TextView
                            android:id="@+id/profileUpdateStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="点击检查"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_action_back"
                            android:tint="#FFCCCCCC"
                            android:rotation="180"
                            android:layout_marginStart="6dp"
                            android:contentDescription="箭头" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_light"
                        android:layout_marginHorizontal="16dp" />

                    <!-- 查看更新日志 -->
                    <LinearLayout
                        android:id="@+id/profileBtnChangelog"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_action_info"
                            android:tint="@color/brand_primary"
                            android:contentDescription="日志" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="更新日志"
                            android:textSize="15sp"
                            android:textColor="#FF333333"
                            android:layout_marginStart="12dp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_action_back"
                            android:tint="#FFCCCCCC"
                            android:rotation="180"
                            android:layout_marginStart="6dp"
                            android:contentDescription="箭头" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_light"
                        android:layout_marginHorizontal="16dp" />

                    <!-- 开源 GitHub -->
                    <LinearLayout
                        android:id="@+id/profileBtnGitHub"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_action_github"
                            android:tint="#FF333333"
                            android:contentDescription="GitHub" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="开源仓库"
                            android:textSize="15sp"
                            android:textColor="#FF333333"
                            android:layout_marginStart="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apache 2.0"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_action_back"
                            android:tint="#FFCCCCCC"
                            android:rotation="180"
                            android:layout_marginStart="6dp"
                            android:contentDescription="箭头" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_light"
                        android:layout_marginHorizontal="16dp" />

                    <!-- 统计面板 -->
                    <LinearLayout
                        android:id="@+id/profileBtnStats"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_action_memory"
                            android:tint="@color/brand_secondary"
                            android:contentDescription="统计" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="统计面板"
                            android:textSize="15sp"
                            android:textColor="#FF333333"
                            android:layout_marginStart="12dp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_action_back"
                            android:tint="#FFCCCCCC"
                            android:rotation="180"
                            android:layout_marginStart="6dp"
                            android:contentDescription="箭头" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_light"
                        android:layout_marginHorizontal="16dp" />

                    <!-- 设置 -->
                    <LinearLayout
                        android:id="@+id/profileBtnSettings"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_action_settings"
                            android:tint="@color/text_secondary"
                            android:contentDescription="设置" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AI 模型配置"
                            android:textSize="15sp"
                            android:textColor="#FF333333"
                            android:layout_marginStart="12dp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_action_back"
                            android:tint="#FFCCCCCC"
                            android:rotation="180"
                            android:layout_marginStart="6dp"
                            android:contentDescription="箭头" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 底部版权 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Made with ❤️ by MobileClaw Team\n开源协议：Apache License 2.0"
                android:textSize="11sp"
                android:textColor="#FFBBBBBB"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>