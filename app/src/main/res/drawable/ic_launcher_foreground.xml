<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：三爪痕矢量设计
  - 三个优雅的弧形爪痕，从下向上延伸
  - 每道爪痕有三层：辉光层(宽/半透明) + 主色层(亮青) + 高光层(窄/白)
  - 安全区 72dp 内居中
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ==================== 辉光层（最宽，半透明，在爪痕后方） ==================== -->

    <!-- 左爪辉光 -->
    <path
        android:pathData="M30,72 C26,52 20,38 14,28"
        android:strokeWidth="12"
        android:strokeColor="#FF00D4FF"
        android:strokeAlpha="0.15"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- 中爪辉光 -->
    <path
        android:pathData="M54,76 C54,52 54,34 54,20"
        android:strokeWidth="14"
        android:strokeColor="#FF00D4FF"
        android:strokeAlpha="0.15"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- 右爪辉光 -->
    <path
        android:pathData="M78,72 C82,52 88,38 94,28"
        android:strokeWidth="12"
        android:strokeColor="#FF00D4FF"
        android:strokeAlpha="0.15"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- ==================== 主色层（亮青色爪痕主体） ==================== -->

    <!-- 左爪 -->
    <path
        android:pathData="M30,72 C26,52 20,38 14,28"
        android:strokeWidth="7"
        android:strokeColor="#FF00D4FF"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- 中爪（最高最粗） -->
    <path
        android:pathData="M54,76 C54,52 54,34 54,20"
        android:strokeWidth="8"
        android:strokeColor="#FF00D4FF"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- 右爪 -->
    <path
        android:pathData="M78,72 C82,52 88,38 94,28"
        android:strokeWidth="7"
        android:strokeColor="#FF00D4FF"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- ==================== 高光层（白色半透明，提升质感） ==================== -->

    <!-- 左爪高光 -->
    <path
        android:pathData="M30,72 C26,52 20,38 14,28"
        android:strokeWidth="3"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.35"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- 中爪高光 -->
    <path
        android:pathData="M54,76 C54,52 54,34 54,20"
        android:strokeWidth="3.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.35"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- 右爪高光 -->
    <path
        android:pathData="M78,72 C82,52 88,38 94,28"
        android:strokeWidth="3"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.35"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

</vector>